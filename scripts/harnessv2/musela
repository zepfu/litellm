#!/usr/bin/env python3
"""musela: inspect-derived muse --base-url aimed at litellm-alpha.

Sets --base-url from docker inspect of litellm-alpha (today
127.0.0.1:4011 origin, no /v1 and no /muse-code). Never targets
:4000 / aawm-litellm, :4001 / litellm-dev, or muselt/musel. Does
not exec the operator Tailscale musela wrapper.

Usage:
  python scripts/harnessv2/musela --print-url
  python scripts/harnessv2/musela [--] [muse args...]
"""

from __future__ import annotations

import os
import sys
from pathlib import Path

HARNESS_DIR = Path(__file__).resolve().parent
if str(HARNESS_DIR) not in sys.path:
    sys.path.insert(0, str(HARNESS_DIR))

from hv2.errors import HarnessError  # noqa: E402
from hv2.load_config import load_config  # noqa: E402
from hv2.musela import muse_binary, musela_argv, resolve_musela_base_url  # noqa: E402


def main(argv: list[str] | None = None) -> int:
    args = list(sys.argv[1:] if argv is None else argv)
    try:
        config = load_config()
        base_url = resolve_musela_base_url(config)
        if args[:1] == ["--print-url"]:
            sys.stdout.write(f"{base_url}\n")
            return 0
        if args[:1] == ["--"]:
            args = args[1:]
        muse = muse_binary()
        env = os.environ.copy()
        env.setdefault("MUSE_DISABLE_ULTRA_ANIMATIONS", "1")
        os.execvpe(muse, musela_argv(args, binary=muse, base_url=base_url), env)
    except HarnessError as vis:
        sys.stderr.write(f"musela: {vis}\n")
        return int(getattr(vis, "exit_code", 2) or 2)
    except FileNotFoundError as vis:
        sys.stderr.write(f"musela: Muse executable is unavailable: {vis}\n")
        return 127
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

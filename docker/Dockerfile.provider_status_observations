FROM python:3.13-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    DEBIAN_FRONTEND=noninteractive \
    AAWM_LITELLM_ENVIRONMENT=dev \
    AAWM_PROVIDER_STATUS_APPLY=1 \
    AAWM_PROVIDER_STATUS_INTERVAL_SECONDS=300 \
    AAWM_PROVIDER_STATUS_TIMEOUT=2 \
    AAWM_PROVIDER_STATUS_PING_COUNT=1 \
    AAWM_PROVIDER_STATUS_PING_TIMEOUT=2 \
    AAWM_PROVIDER_STATUS_SKIP_ICMP=0 \
    AAWM_PROVIDER_STATUS_SETUP_SCHEMA_ON_START=1 \
    AAWM_PROVIDER_STATUS_DB_LOCK_TIMEOUT_MS=1000 \
    AAWM_PROVIDER_STATUS_DB_STATEMENT_TIMEOUT_MS=5000 \
    LITELLM_KIMI_NATIVE_CONTRACT_PATH=/app/kimi-descriptor/native-contract.json \
    LITELLM_KIMI_NATIVE_CONTRACT_REQUIRED=false \
    AAWM_GROK_CLIENT_VERSION_CACHE_PATH=/run/aawm/grok/native-client-version.json \
    AAWM_GROK_CLIENT_VERSION_CACHE_MAX_AGE_SECONDS=172800

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        iputils-ping \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

RUN pip install --no-cache-dir "psycopg[binary]==3.3.4"

COPY scripts/record_provider_status_observations.py /app/scripts/record_provider_status_observations.py
COPY scripts/grok_oidc_refresh.py /app/scripts/grok_oidc_refresh.py
COPY scripts/codex_oauth_refresh.py /app/scripts/codex_oauth_refresh.py
COPY scripts/xai_oauth_refresh.py /app/scripts/xai_oauth_refresh.py
COPY scripts/kimi_oauth_refresh.py /app/scripts/kimi_oauth_refresh.py
COPY scripts/run_provider_status_observations_loop.py /app/scripts/run_provider_status_observations_loop.py
COPY litellm/secret_managers/credential_error_sanitizer.py /app/litellm/secret_managers/credential_error_sanitizer.py
COPY litellm/secret_managers/credential_file_lock.py /app/litellm/secret_managers/credential_file_lock.py
COPY litellm/secret_managers/credential_file_metadata.py /app/litellm/secret_managers/credential_file_metadata.py
COPY litellm/secret_managers/credential_file_write.py /app/litellm/secret_managers/credential_file_write.py
# Grok native OIDC auth-path resolver (pure-stdlib).
COPY litellm/secret_managers/grok_oidc_auth_path.py /app/litellm/secret_managers/grok_oidc_auth_path.py
# Codex OAuth credential inventory (pure-stdlib).
COPY litellm/secret_managers/codex_oauth_inventory.py /app/litellm/secret_managers/codex_oauth_inventory.py
# Canonical Kimi endpoint/contract resolver (pure-stdlib, MS-030/MS-031).
COPY litellm/secret_managers/kimi_native_contract.py /app/litellm/secret_managers/kimi_native_contract.py
# Grok native client-version cache contract (pure-stdlib, xai-002).
COPY litellm/secret_managers/grok_native_version_contract.py /app/litellm/secret_managers/grok_native_version_contract.py
# Cursor Agent monthly usage poller (pure-stdlib). Do not COPY common_utils.py.
COPY litellm/llms/cursor_agent/usage.py /app/litellm/llms/cursor_agent/usage.py
COPY litellm/llms/cursor_agent/usage_client.py /app/litellm/llms/cursor_agent/usage_client.py
RUN touch \
    /app/scripts/__init__.py \
    /app/litellm/__init__.py \
    /app/litellm/secret_managers/__init__.py \
    /app/litellm/llms/__init__.py \
    /app/litellm/llms/cursor_agent/__init__.py

# The sanitized Kimi native descriptor is mounted read-only by compose at
# /app/kimi-descriptor.  The image itself ships only the contract module and
# the descriptor path gate; it never bundles OAuth credentials or the Kimi home.
RUN mkdir -p /app/kimi-descriptor

# Grok native client-version cache directory; compose mounts the host cache
# read-only here.  The image ships only the directory and the contract module.
RUN mkdir -p /run/aawm/grok

ENTRYPOINT ["python", "/app/scripts/run_provider_status_observations_loop.py"]

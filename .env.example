# OpenAI
OPENAI_API_KEY = ""
OPENAI_BASE_URL = ""
# Cohere
COHERE_API_KEY = ""
# OpenRouter
OR_SITE_URL = ""
OR_APP_NAME = "LiteLLM Example app"
OR_API_KEY = ""
# Azure API base URL
AZURE_API_BASE = ""
# Azure API version
AZURE_API_VERSION = ""
# Azure API key
AZURE_API_KEY = ""
# Replicate
REPLICATE_API_KEY = ""
REPLICATE_API_TOKEN = ""
# Anthropic
ANTHROPIC_API_KEY = ""
# Infisical
INFISICAL_TOKEN = ""
# Novita AI
NOVITA_API_KEY = ""
# INFINITY
INFINITY_API_KEY = ""

# Development Configs
LITELLM_MASTER_KEY = "sk-1234"
DATABASE_URL = "postgresql://llmproxy:dbpassword9090@db:5432/litellm"
STORE_MODEL_IN_DB = "True"


# Shared AAWM DB selectors. In split deployments these feed the
# callback/session-history pool and OpenRouter/Codex quota hydration (for
# example litellm_dev); the values below preserve the single-database local
# example.
# Runtime traffic uses the shared PgBouncer endpoint. Maintenance, schema, and
# backfill scripts should use AAWM_DIRECT_DATABASE_URL or an explicit --pg-dsn.
AAWM_DB_HOST = 127.0.0.1
AAWM_DB_PORT = 6432
AAWM_DB_NAME = aawm_tristore
AAWM_DB_USER = aawm
AAWM_DB_PWD = your_aawm_db_password
AAWM_DB_SSLMODE = disable
AAWM_DATABASE_URL = "postgresql://aawm:your_aawm_db_password@127.0.0.1:6432/aawm_tristore?application_name=aawm-litellm-session-history"
AAWM_DIRECT_DATABASE_URL = "postgresql://aawm:your_aawm_db_password@127.0.0.1:5434/aawm_tristore"
AAWM_SESSION_HISTORY_DB_APPLICATION_NAME = aawm-litellm-session-history
AAWM_SESSION_HISTORY_STATEMENT_CACHE_SIZE = 0
AAWM_DYNAMIC_INJECTION_DB_APPLICATION_NAME = aawm-litellm-dynamic-injection
# Dynamic-injection/tristore DB (aawm_tristore). Dynamic context queries
# (ag_catalog.raw_content, tristore_search_exact) use these dedicated selectors
# when set. When unset, each selector falls back to the matching AAWM_DB_*
# value above.
# AAWM_DYNAMIC_INJECTION_DB_HOST = 127.0.0.1
# AAWM_DYNAMIC_INJECTION_DB_PORT = 6432
# AAWM_DYNAMIC_INJECTION_DB_NAME = aawm_tristore
# AAWM_DYNAMIC_INJECTION_DB_USER = aawm
# AAWM_DYNAMIC_INJECTION_DB_PASSWORD = your_aawm_db_password
# AAWM_DYNAMIC_INJECTION_DB_SSLMODE = disable
# AAWM_DYNAMIC_INJECTION_DB_URL = "postgresql://aawm:your_aawm_db_password@127.0.0.1:6432/aawm_tristore"
PGAPPNAME = aawm-litellm-runtime
AAWM_PROVIDER_STATUS_DB_APPLICATION_NAME = aawm-provider-status-observations
AAWM_PROVIDER_STATUS_SETUP_SCHEMA_ON_START = 0

# Alias-routing state (dev)
# Dedicated Redis-backed state store for alias-routing durable state.
AAWM_ALIAS_ROUTING_REDIS_HOST = aawm-alias-routing-redis
AAWM_ALIAS_ROUTING_REDIS_PORT = 6379
AAWM_ALIAS_ROUTING_REDIS_URL = ""
AAWM_ALIAS_ROUTING_REDIS_USERNAME = ""
AAWM_ALIAS_ROUTING_REDIS_DB = 0
AAWM_ALIAS_ROUTING_REDIS_PASSWORD = ""
AAWM_ALIAS_ROUTING_REDIS_SSL = 0
AAWM_ALIAS_ROUTING_STATE_NAMESPACE = aawm-routing-dev-v1
# Cooldown-clear endpoint topology gate (dev). Must be exactly "1" to enable
# POST /aawm/alias-routing/cooldowns/clear. Any other value (absent, false,
# multi-worker) fails closed. Only set on single-worker dev deployments.
AAWM_ALIAS_ROUTING_COOLDOWN_CLEAR_SINGLE_WORKER = 1

# External Docker network (dev)
# The aawm-infrastructure stack creates the shared network. Override only if
# the infrastructure project directory (and thus network name) differs.
AAWM_INFRASTRUCTURE_NETWORK_NAME = aawm-infrastructure_default

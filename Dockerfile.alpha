FROM python:3.13-slim

# Build dependencies for C extensions.
RUN apt-get update \
    && apt-get install -y --no-install-recommends gcc g++ make \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install dependencies before source so ordinary source edits do not invalidate
# the dependency layer.
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

# Install the project and its alpha-owned runtime configuration into the image.
COPY . .
RUN pip install --no-cache-dir -e . \
    && pip install --no-cache-dir asyncpg h2==4.3.0 hypercorn==0.15.0 langfuse

# The alpha candidate set overrides the packaged shared alias for this image.
COPY config/alpha-alias-overrides/provider-openai.yaml \
    /app/litellm/proxy/aawm_alias_config/provider-openai.yaml

ENV PYTHONPATH=/app \
    PYTHONDONTWRITEBYTECODE=1

EXPOSE 4011

CMD ["litellm", "--config", "/app/litellm-alpha-config.yaml", "--port", "4011", "--run_hypercorn"]
